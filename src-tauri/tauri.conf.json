{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dòng Đời",
  "version": "1.0.0",
  "identifier": "com.legacyoface.dongdoi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dòng Đời — Legacy of Ages v1.0.0",
        "width": 1366,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../public/assets/common/ui/app-icon.svg"
    ]
  }
}
